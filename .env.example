# Copy to .env and fill in only what you use. Everything is optional:
# with no keys at all OpenInfer runs on the echo backend (and Ollama if it is running).

# Path to the routing policy. Defaults to ./openinfer.yaml if present.
OPENINFER_CONFIG=openinfer.yaml

# Bind address for `openinfer serve` (Hugging Face Spaces expects 7860).
OPENINFER_HOST=0.0.0.0
OPENINFER_PORT=8000

# Optional bearer token clients must send as "Authorization: Bearer <token>".
# Leave empty to run without auth (fine on localhost, not on the public internet).
OPENINFER_API_KEY=

# Cost ledger. SQLite file by default; a Postgres URL works with the "postgres" extra.
OPENINFER_LEDGER_URL=sqlite:///./openinfer.db
# OPENINFER_LEDGER_URL=postgresql://user:pass@host:5432/openinfer

# Local backends
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001/v1
# Path to a GGUF file for the llama.cpp backend (install extra: uv sync --extra llamacpp)
LLAMACPP_MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf

# Cloud backends (all have free tiers). Only backends whose key is present are enabled.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Hugging Face token: only needed for gated models when running `openinfer download-model`.
HF_TOKEN=
